xt":" ","kind":"text"},{"text":"activity","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/ModelHealth\/documentation\/ModelHealth\/Activity","preciseIdentifier":"s:11ModelHealth8ActivityV","text":"Activity","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> [","kind":"text"},{"identifier":"doc:\/\/ModelHealth\/documentation\/ModelHealth\/ResultData","preciseIdentifier":"s:11ModelHealth10ResultDataV","text":"ResultData","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"types","content":[{"type":"paragraph","inlineContent":[{"text":"The types of result data to download (kinematic, visualization, or both)","type":"text"}]}]},{"name":"activity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The completed activity to download data from"}]}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"An array of result files with their formats. Returns an empty array if no"},{"type":"text","text":" "},{"type":"text","text":"results are available or all downloads fail."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After an activity completes processing, various result files become available for download."},{"type":"text","text":" "},{"type":"text","text":"Use this method to retrieve specific types of data (kinematic measurements, visualizations)"},{"type":"text","text":" "},{"type":"text","text":"in their native file formats (JSON, CSV)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is useful when you need access to raw analysis data rather than the"},{"type":"text","text":" "},{"type":"text","text":"structured metrics provided by "},{"type":"reference","identifier":"doc:\/\/ModelHealth\/documentation\/ModelHealth\/ModelHealthService\/downloadAnalysisResult(forActivity:resultTag:)","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["\/\/ Download kinematic data only","let kinematicData = await service.data(ofType: [.kinematic], for: activity)","","for result in kinematicData {","    switch result.fileType {","    case .json:","        let decoder = JSONDecoder()","        if let jsonData = try? decoder.decode([String: Any].self, from: result.data) {","            print(\"Parsed kinematic JSON\")","        }","","    case .csv:","        if let csvString = String(data: result.data, encoding: .utf8) {","            print(\"CSV data:\\n\\(csvString)\")","        }","    }","}","","\/\/ Download all available data types","let allData = await service.data(","    ofType: [.kinematic, .visualization],","    for: activity",")","print(\"Downloaded \\(allData.count) result files\")"]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This method performs concurrent downloads for optimal performance."},{"type":"text","text":" "},{"type":"text","text":"Individual download failures do not affect other requests and failed downloads"},{"type":"text","text":" "},{"type":"text","text":"are silently excluded from results."}]}],"name":"Note","style":"note"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/modelhealth\/modelhealthservice\/data(oftype:for:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ModelHealth\/documentation\/ModelHealth\/ModelHealthService\/data(ofType:for:)"},"references":{"doc://ModelHealth/documentation/ModelHealth/Activity":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Activity
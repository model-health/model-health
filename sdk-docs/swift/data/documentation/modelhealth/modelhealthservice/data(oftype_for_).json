{"abstract":[{"text":"Downloads result data files from a processed activity.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/modelhealth\/modelhealthservice\/data(oftype:for:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/ModelHealth\/documentation\/ModelHealth","doc:\/\/ModelHealth\/documentation\/ModelHealth\/ModelHealthService"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"data","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofType","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"types","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/ModelHealth\/documentation\/ModelHealth\/ResultDataType","text":"ResultDataType","kind":"typeIdentifier","preciseIdentifier":"s:11ModelHealth14ResultDataTypeO"},{"text":">, ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"activity","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Activity","preciseIdentifier":"s:11ModelHealth8ActivityV","kind":"typeIdentifier","identifier":"doc:\/\/ModelHealth\/documentation\/ModelHealth\/Activity"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"ResultData","preciseIdentifier":"s:11ModelHealth10ResultDataV","kind":"typeIdentifier","identifier":"doc:\/\/ModelHealth\/documentation\/ModelHealth\/ResultData"},{"text":"]","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"types","content":[{"inlineContent":[{"type":"text","text":"The types of result data to download (kinematic, visualization, or both)"}],"type":"paragraph"}]},{"name":"activity","content":[{"inlineContent":[{"text":"The completed activity to download data from","type":"text"}],"type":"paragraph"}]}]},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"An array of result files with their formats. Returns an empty array if no"},{"type":"text","text":" "},{"type":"text","text":"results are available or all downloads fail."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"After an activity completes processing, various result files become available for download.","type":"text"},{"text":" ","type":"text"},{"text":"Use this method to retrieve specific types of data (kinematic measurements, visualizations)","type":"text"},{"text":" ","type":"text"},{"text":"in their native file formats (JSON, CSV).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This method is useful when you need access to raw analysis data rather than the","type":"text"},{"text":" ","type":"text"},{"text":"structured metrics provided by ","type":"text"},{"identifier":"doc:\/\/ModelHealth\/documentation\/ModelHealth\/ModelHealthService\/downloadAnalysisResult(forActivity:resultTag:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"code":["\/\/ Download kinematic data only","let kinematicData = await service.data(ofType: [.kinematic], for: activity)","","for result in kinematicData {","    switch result.fileType {","    case .json:","        let decoder = JSONDecoder()","        if let jsonData = try? decoder.decode([String: Any].self, from: result.data) {","            print(\"Parsed kinematic JSON\")","        }","","    case .csv:","        if let csvString = String(data: result.data, encoding: .utf8) {","            print(\"CSV data:\\n\\(csvString)\")","        }","    }","}","","\/\/ Download all available data types","let allData = await service.data(","    ofType: [.kinematic, .visualization],","    for: activity",")","print(\"Downloaded \\(allData.count) result files\")"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"This method performs concurrent downloads for optimal performance.","type":"text"},{"text":" ","type":"text"},{"text":"Individual download failures do not affect other requests and failed downloads","type":"text"},{"text":" ","type":"text"},{"text":"are silently excluded from results.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"data"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofType"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:11ModelHealth14ResultDataTypeO","kind":"typeIdentifier","text":"ResultDataType"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11ModelHealth8ActivityV","kind":"typeIdentifier","text":"Activity"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> ["},{"preciseIdentifier":"s:11ModelHealth10ResultDataV","kind":"typeIdentifier","text":"ResultData"},{"kind":"text","text":"]"}],"role":"symbol","symbolKind":"method","roleHeading":"Instance Method","externalID":"s:11ModelHealth0aB7ServiceC4data6ofType3forSayAA10ResultDataVGShyAA0hiF0OG_AA8ActivityVtYaF","modules":[{"name":"ModelHealth"}],"title":"data(ofType:for:)"},"identifier":{"url":"doc:\/\/ModelHealth\/documentation\/ModelHealth\/ModelHealthService\/data(ofType:for:)","interfaceLanguage":"swift"},"references":{"doc://ModelHealth/documentation/ModelHealth/Activity":{"title":"Activity","type":"topic","abstract":[{"text":"A movement recording session with associated videos and a
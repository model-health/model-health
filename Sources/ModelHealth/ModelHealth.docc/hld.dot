digraph workflow {
    rankdir=LR;
    ranksep=0.8;
    nodesep=0.6;
    splines=ortho;
    
    node [shape=box, style=filled, fontname="Arial", fontsize=24];
    edge [fontsize=20];
    
    // Main workflow nodes at same rank
    node [style=filled];
    start [label="Start", fillcolor="#4A90E2", fontcolor=black];
    session [label="Create Session", fillcolor="#F5A623", fontcolor=black];
    recordstart [label="Start Recording", fillcolor="#7ED321", fontcolor=black];
    analyzestart [label="Start Analysis", fillcolor="#9C27B0", fontcolor=white];
    
    // Authentication nodes
    auth [label="User Auth", fillcolor="#4A90E2", fontcolor=black];
    verify [label="Verify Code", fillcolor="#4A90E2", fontcolor=black];
    
    // Calibration nodes
    camcalib [label="Camera Calibration", fillcolor="#F5A623", fontcolor=black];
    selectsubj [label="Select Subject", fillcolor="#F5A623", fontcolor=black];
    neutral [label="Neutral Pose", fillcolor="#F5A623", fontcolor=black];
    
    // Recording nodes
    stop [label="Stop", fillcolor="#7ED321", fontcolor=black];
    checkstatus [label="Check Recording\nStatus", fillcolor="#FFC107", fontcolor=black];
    
    // Analysis nodes
    pollanalysis [label="Poll Analysis", fillcolor="#FFC107", fontcolor=black];
    download [label="Download", fillcolor="#9C27B0", fontcolor=white];
    view [label="View Metrics", fillcolor="#9C27B0", fontcolor=white];
    
    // Error nodes
    error [label="⚠ Error", fillcolor="#F44336", fontcolor=white];
    
    // Decision nodes
    node [shape=diamond, fillcolor=white, fontcolor=black];
    more [label="More\nTrials?"];
    retry [label="Retry?"];
    
    // End node
    node [shape=box];
    end [label="End", fillcolor="#4A90E2", fontcolor=black];
    
    // Define ranks for vertical alignment - moved auth and verify one column right
    {rank=min; start;}
    {rank=same; session; camcalib; auth; recordstart; analyzestart;}
    {rank=same; selectsubj; verify; stop; pollanalysis;}
    {rank=same; neutral; checkstatus; download;}
    {rank=same; error; view;}
    {rank=same; retry; more;}
    {rank=max; end;}
    
    // Connections - Authentication flow
    start -> auth;
    auth -> session [xlabel="Trusted"];
    auth -> verify [xlabel="Required"];
    verify:n -> verify:e [xlabel="Retry"];
    verify -> session [xlabel="Success"];
    
    // Calibration flow
    session -> camcalib;
    camcalib -> selectsubj;
    selectsubj -> neutral;
    neutral -> recordstart;
    
    // Recording flow
    recordstart -> stop;
    stop -> checkstatus;
    checkstatus:n -> checkstatus:w [xlabel="Poll"];
    checkstatus -> analyzestart [xlabel="On Ready"];
    checkstatus -> error [xlabel="Failed"];
    
    // Analysis flow
    analyzestart -> pollanalysis;
    pollanalysis:n -> pollanalysis:w [xlabel="Poll"];
    pollanalysis -> download [xlabel="Success"];
    pollanalysis -> error [xlabel="Failed"];
    download -> view;
    
    // Error handling - arrow from top of Retry diamond
    error -> retry;
    retry:n -> recordstart [xlabel="Yes"];
    retry -> end [xlabel="No"];
    
    // Looping and decisions
    view -> more;
    more -> recordstart [xlabel="Yes"];
    more -> end [xlabel="No"];
}
